# Basis data Neon Postgres — belum dipakai MVP, disiapkan untuk
# penyimpanan riwayat dan pemulihan lintas perangkat (PRD Bagian 13.2).
# Tanpa awalan NEXT_PUBLIC_ agar tidak pernah sampai ke peramban.
DATABASE_URL=

# Kunci OpenRouter untuk penyusunan halaman Peta Jalan. Bersifat opsional:
# tanpa kunci ini, peta jalan disusun dari katalog tindakan berbasis aturan
# dan antarmuka menyatakan hal itu kepada pengguna.
#
# Ambil kunci gratis di https://openrouter.ai/keys. Rute hanya memanggil
# model berjenjang gratis, jadi tidak perlu mengisi saldo. Jenjang gratis
# dibatasi jumlah permintaan per menit dan per hari; begitu batasnya
# tersentuh, peta jalan jatuh ke jalur aturan, bukan menampilkan galat.
#
# Tanpa awalan NEXT_PUBLIC_ agar tidak pernah sampai ke peramban.
OPENROUTER_API_KEY=
